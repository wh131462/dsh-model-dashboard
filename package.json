{
  "name": "@eternalheart/dsh-model-dashboard",
  "version": "1.0.1",
  "type": "module",
  "description": "model-dashboard: a control-room dashboard for DeepSeek Harness beside the sidebar automation tasks — inspect and edit the model configuration, see per-provider balances and gateway model catalogs, detect reasoning-effort support, and read token usage statistics.",
  "license": "MIT",
  "author": "EternalHeart <hao131462@qq.com>",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "docs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "pub": "node scripts/pub.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wh131462/dsh-model-dashboard.git"
  },
  "homepage": "https://github.com/wh131462/dsh-model-dashboard#readme",
  "bugs": {
    "url": "https://github.com/wh131462/dsh-model-dashboard/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-dashboard",
    "model-configuration",
    "usage-statistics",
    "token-usage",
    "llm"
  ]
}
